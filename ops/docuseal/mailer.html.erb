<%# eazy/access house layout for DocuSeal's emails. Replaces app/views/layouts/mailer.html.erb in
    docuseal/docuseal:3.4.0, mounted read-only (see README.md). Same tokens as src/email.js.
    DocuSeal's attribution (shared/mailer_attribution) stays, as its licence requires. %>
<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <title></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <%# No <style> block: DocuSeal builds the plain-text part by stripping this HTML, and a style block's rules would show up as text. Inline styles only, as in src/email.js. %>
  </head>
  <body dir="<%= TextUtils.rtl?(yield) ? 'rtl' : 'auto' %>" style="margin:0;padding:0;background:#F3F3F1">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F3F3F1"><tr><td align="center" style="padding:32px 16px">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px">
        <tr><td style="padding:0 4px 20px"><a href="https://eazyaccess.org/" style="text-decoration:none"><img src="https://eazyaccess.org/brand/wordmark-email.png" width="140" height="27" alt="eazy/access" style="display:block;border:0;width:140px;height:auto"></a></td></tr>
        <tr><td style="background:#FFFFFF;border-radius:20px;padding:36px 32px;font:400 17px/1.55 -apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#0B0B0C">
          <%= yield %>
        </td></tr>
        <tr><td style="padding:20px 4px 0;font:400 12px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#5E5E62">EAZY ACCESS LTD · Registered in England and Wales, company number 13205428 · Registered office: 71–75 Shelton Street, Covent Garden, London WC2H 9JQ</td></tr>
        <tr><td style="padding:12px 4px 0;font:400 11px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#5E5E62">
          <%= render partial: 'shared/mailer_attribution' %>
        </td></tr>
      </table>
    </td></tr></table>
  </body>
</html>
