{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eazyaccess-org",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [{ "name": "CONTACT_RL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true },
  // TURNSTILE_SECRET is a secret: `wrangler secret put TURNSTILE_SECRET`
  // Custom domain is added only after Abu Aaliyah approves the DNS change (gate F).
  "workers_dev": true
}
